# Server Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
VITE_HOST=0.0.0.0
VITE_PORT=3000

# Central Licence Server
APP_ENV=production
APP_URL=https://licence.example.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=licence_system
DB_USER=licence_user
DB_PASSWORD=CHANGE_ME

LICENCE_PRIVATE_KEY_PATH=/secure/licence-private.key
LICENCE_PUBLIC_KEY_PATH=/secure/licence-public.key

# Customer Core Backend
LICENCE_SERVER_URL=https://licence.example.com/api
LICENCE_PRODUCT_CODE=EMS
LICENCE_PUBLIC_KEY_PATH=/secure/licence-public.key
LICENCE_INSTALLATION_PATH=/app/storage/licence/installation-id.txt
LICENCE_CERTIFICATE_PATH=/app/storage/licence/licence-certificate.json
LICENCE_VALIDATION_STATE_PATH=/app/storage/licence/validation-state.json
LICENCE_VALIDATION_INTERVAL_HOURS=24
LICENCE_OFFLINE_GRACE_DAYS=7
APP_VERSION=1.0.0

# React Frontend
VITE_API_BASE_URL=/api
