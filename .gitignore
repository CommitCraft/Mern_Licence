# ============================================================
#  .gitignore — Mern_Licence (MERN + TypeScript)
#  Generated for: Node.js · React · TypeScript · MySQL
# ============================================================


# ─────────────────────────────────────────
#  ENVIRONMENT & SECRETS  (NEVER commit!)
# ─────────────────────────────────────────
.env
.env.*
!.env.example          # keep the example file
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx


# ─────────────────────────────────────────
#  LICENCE KEYS & SENSITIVE STORAGE
# ─────────────────────────────────────────
storage/licence/licence-private.key
storage/licence/licence-public.key
storage/licence/installation-id.txt
storage/licence/licence-certificate.json
storage/licence/validation-state.json
/storage/


# ─────────────────────────────────────────
#  NODE MODULES
# ─────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/
hostinger_deploy/node_modules/


# ─────────────────────────────────────────
#  BUILD OUTPUT
# ─────────────────────────────────────────
# TypeScript compiled output
dist/
backend/dist/
build/
frontend/dist/
frontend/build/

# Vite cache
frontend/.vite/
.vite/


# ─────────────────────────────────────────
#  TYPESCRIPT
# ─────────────────────────────────────────
*.js.map
*.d.ts.map
tsconfig.tsbuildinfo
backend/tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo


# ─────────────────────────────────────────
#  LOGS
# ─────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ─────────────────────────────────────────
#  PACKAGE MANAGER
# ─────────────────────────────────────────
# Uncomment the lock file you do NOT use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
.npm/
.yarn/
.pnp.*


# ─────────────────────────────────────────
#  DATABASE
# ─────────────────────────────────────────
*.sql
*.sqlite
*.sqlite3
*.db
database/dumps/
database/*.backup


# ─────────────────────────────────────────
#  TESTING & COVERAGE
# ─────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
backend/tests/output/


# ─────────────────────────────────────────
#  OS GENERATED FILES
# ─────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# ─────────────────────────────────────────
#  EDITORS & IDEs
# ─────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json   # optional: share recommended extensions
!.vscode/settings.json     # optional: share workspace settings

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws

# Vim / Neovim
*.swp
*.swo
*.swn

# Emacs
\#*\#
.\#*


# ─────────────────────────────────────────
#  DEPLOYMENT / HOSTING ARTIFACTS
# ─────────────────────────────────────────
*.zip
*.tar.gz
*.tar.bz2
hostinger_deploy.zip
hostinger_deploy/


# ─────────────────────────────────────────
#  SCRATCH / TEMP SCRIPTS
# ─────────────────────────────────────────
scratch_*.ts
scratch_*.js
backend/scratch_*.ts
backend/scratch_*.js
tmp/
temp/
.tmp/


# ─────────────────────────────────────────
#  MISCELLANEOUS
# ─────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tgz
*.local
